# Optional for startup; required only for AI-backed API routes.
# Convex deployment URL - you'll need to create your own Convex project
VITE_CONVEX_URL=YOUR_CONVEX_URL_HERE
# Allow unauthenticated exercise access for development
VITE_DEV_AUTH=true
IMPORT_TRAINER_EMAIL=your_email_here
IMPORT_TRAINER_PASSWORD=your_password_here

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-convex-project

VITE_CONVEX_SITE_URL=https://your-convex-project.convex.site

# JWT secret for dev auth (required for server to start)
JWT_SECRET=your_jwt_secret_here

# Unsplash API key (used server-side for image search proxy)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# AI Features (optional; used server-side for Gemini-backed API routes)
GEMINI_API_KEY=your_gemini_api_key_here
