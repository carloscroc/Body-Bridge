{
  "name": "forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:convex": "npx convex dev",
    "dev:all": "concurrently \"npm run dev:convex\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/server.js",
    "build": "vite build && node scripts/postbuild-csp.mjs",
    "test": "npm run test:playwright",
    "preview": "vite preview",
    "capture-exercise-images": "node scripts/captureExerciseImages.js",
    "capture-exercise-images:dry": "node scripts/captureExerciseImages.js --dry-run --limit 5",
    "test:playwright": "npx playwright test"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.90",
    "@google/genai": "^1.40.0",
