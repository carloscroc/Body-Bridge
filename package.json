{
  "name": "body-bridge-fitness",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "config:generate": "node scripts/generateAppConfig.cjs",
    "postinstall": "node scripts/patch-capacitor-android.cjs",
    "dev": "npm run dev:all",
    "dev:app": "concurrently --kill-others --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:convex": "node scripts/runConvexDev.mjs",
    "dev:all": "npm run config:generate && concurrently --kill-others --names \"CONVEX,SERVER,CLIENT\" --prefix-colors \"yellow,blue,green\" \"npm run dev:convex\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "node scripts/runViteDev.mjs",
    "dev:server": "node server/server.js",
    "deploy:convex": "node scripts/deployConvex.mjs",
    "build": "node scripts/ensureBuildEnv.cjs && vite build --mode production && node scripts/postbuild-csp.mjs && node scripts/postbuild-memory.js && node scripts/verifyBuild.cjs",
    "test": "npm run test:playwright && node scripts/posttest-memory.js",
    "preview": "vite preview",
    "capture-exercise-images": "node scripts/captureExerciseImages.js",
    "capture-exercise-images:dry": "node scripts/captureExerciseImages.js --dry-run --limit 5",
    "test:playwright": "npx playwright test",
    "memory:save": "node scripts/context-manager.js save",
    "memory:restore": "node scripts/context-manager.js restore",
    "memory:recent": "node scripts/mempalace-client.js recent",
    "memory:search": "node scripts/mempalace-client.js retrieve",
    "memory:stats": "node scripts/mempalace-client.js stats",
    "memory:history": "node scripts/context-manager.js history",
    "memory:autosave": "node scripts/context-manager.js autosave",
    "memory:session-start": "node scripts/memory-hooks.js session-start",
    "memory:session-end": "node scripts/memory-hooks.js session-end",
    "security:scan": "semgrep --config p/security-audit src convex && node scripts/security-memory.js",
    "create-ticket": "node scripts/create-plane-ticket.cjs",
    "create-ticket:dry": "node scripts/create-plane-ticket.cjs --dry-run",
    "start-symphony": "node scripts/start-symphony-work.cjs",
    "collect-evidence": "node scripts/start-symphony-work.cjs --evidence-only",
    "verify-ticket": "node scripts/start-symphony-work.cjs --evidence-only",
    "hermes:prep": "powershell -ExecutionPolicy Bypass -File ./hermes-update-prep.ps1"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@capacitor/core": "6.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@convex-dev/auth": "^0.0.92",
    "@emotion/is-prop-valid": "^1.4.0",
    "@google/genai": "^1.40.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "convex": "^1.42.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "form-data": "^4.0.5",
    "framer-motion": "^12.34.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "minimist": "^1.2.8",
    "morgan": "^1.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "dompurify": "^3.3.1",
    "knip": "^6.12.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
