{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@convex/*": [
        "./convex/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "server/**/*.ts",
    "server/**/*.tsx",
    "server/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts",
    "tailwind.config.js",
    "postcss.config.js",
    "capacitor.config.json",
    "components.json",
    "knip.json",
    "convex.config.ts"
  ],
  "exclude": [
    "convex/**/*.ts",
    "convex/**/*.tsx",
    "tools/plane-testing/**/*",
    "scripts/**/*",
    "convex_backup/**/*",
    "project-archive/**/*",
    "android/**/*",
    "ios/**/*",
    "dist/**/*",
    "node_modules/**/*"
  ]
}
