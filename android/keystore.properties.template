# Keystore configuration for release builds
# IMPORTANT: DO NOT commit this file to version control!
# This file should only exist on your build machine.
#
# Instructions:
# 1. Generate keystore using: keytool -genkey -v -keystore bodybridge-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias bodybridge-key-alias
# 2. Fill in the values below
# 3. Store this file and the keystore.jks file securely
# 4. Add both files to .gitignore

# Path to keystore file (relative to android directory)
storeFile=bodybridge-keystore.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias
keyAlias=bodybridge-key-alias

# Key password
keyPassword=YOUR_KEY_PASSWORD